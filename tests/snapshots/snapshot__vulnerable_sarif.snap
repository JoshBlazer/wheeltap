            }
          ],
          "message": {
            "text": "`Withdraw.authority` is verified by a `has_one` constraint but is never required to sign, and no account in `Withdraw` signs at all. The constraint proves which account this is; it does not prove the holder authorised anything. Public keys are public, so any caller can pass this one."
          },
          "partialFingerprints": {
            "wheeltapFindingId/v1": "2d70e5e62f325c65"
          },
          "properties": {
            "confidence": "high",
            "itemPath": "Withdraw.authority"
          },
          "ruleId": "WT001",
          "ruleIndex": 0
        },
