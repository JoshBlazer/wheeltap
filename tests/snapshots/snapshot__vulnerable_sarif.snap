              },
              "fullDescription": {
                "text": "Two mutable accounts of the same type may be given the same address"
              },
              "help": {
                "text": "Assert that the accounts differ: `constraint = first.key() != second.key()`. Anchor cannot infer it, because passing the same account twice is legitimate in other instructions."
              },
              "helpUri": "https://solana.com/developers/courses/program-security/duplicate-mutable-accounts",
              "id": "WT011",
              "name": "Duplicate mutable accounts",
              "properties": {
                "security-severity": "5.0",
                "tags": [
                  "security",
                  "solana",
                  "anchor"
                ]
              },
              "shortDescription": {
                "text": "Two mutable accounts of the same type may be given the same address"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "A collection is cloned or allocated on every iteration of a loop"
              },
              "help": {
                "text": "Hoist the allocation out of the loop, or borrow instead of cloning. Where the collection is only read, iterate over a reference."
              },
              "helpUri": "https://solana.com/docs/core/fees#compute-budget",
              "id": "WT012",
              "name": "Allocation in a loop",
