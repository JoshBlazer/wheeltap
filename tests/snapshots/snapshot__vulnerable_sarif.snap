              }
            }
          ],
          "message": {
            "text": "`Treasury` stores `authority: Pubkey`, and `Withdraw` takes both `treasury` and `authority`, but never checks that they match. The stored key records a relationship the instruction does not enforce, so any `treasury` can be used with any `authority`."
          },
          "partialFingerprints": {
            "wheeltapFindingId/v1": "0dc13ff4575e2169"
